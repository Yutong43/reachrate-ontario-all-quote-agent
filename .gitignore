# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Local-only visual QA captures. They may contain third-party pages, meeting
# participants, local paths or unredacted browser state and are not submission artifacts.
/design-audit/
/design-references/
/design-qa.md
/.tmp-audit-current/

# Account-bound CLI state. The public templates intentionally require each
# reproducer to create their own ElevenLabs agent and webhook tool.
/tools/elevenlabs-agent-config/agents.json
/tools/elevenlabs-agent-config/tools.json
