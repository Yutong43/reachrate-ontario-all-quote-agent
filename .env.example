# Copy this file to .env.local. Never commit the populated file.

# Preferred: the Supabase Edge Function keeps the admin key inside Supabase.
# Project URLs are not secrets, but placeholders keep this public repository portable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_EDGE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/quote-persistence

# Optional direct-server fallback. Never expose this in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs agent and telephony resources. IDs are configuration,
# not credentials; obtain them from the ElevenLabs dashboard or CLI.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_TOOL_SECRET=

# Safety gate: keep false outside a supervised test window.
OUTBOUND_CALLS_ENABLED=false
OUTBOUND_PHONE_ALLOWLIST=

# Optional public HTTPS URL, only needed when sharing the web UI remotely.
# The ElevenLabs tool writes directly to the authenticated Supabase Edge Function.
APP_BASE_URL=

# Local-only proof: launches a visible Chrome route worker after the user starts a run.
# Never enable this on a public deployment.
LOCAL_BROWSER_AGENT_ENABLED=false
